{
  "servers": [
    {
      "id": "compiler-rules",
      "requireResultId": true,
      "command": "roslyn-language-server",
      "arguments": [
        "--stdio",
        "--telemetryLevel",
        "off",
        "--logLevel",
        "Warning"
      ],
      "languages": {
        ".cs": "csharp"
      },
      "initializationOptions": {
        "autoLoadProjects": 500
      },
      "readyNotification": "workspace/projectInitializationComplete",
      "settings": {
        "projects": {
          "dotnet_enable_automatic_restore": false
        }
      }
    }
  ]
}
