{
  "stryker-config": {
    "project": "SharpLint.Analysis.csproj",
    "configuration": "Debug",
    "test-case-filter": "FullyQualifiedName!~SharpLint.Tests.Lsp.CliTests&FullyQualifiedName!~SharpLint.Tests.Lsp.RoslynIntegrationTests",
    "reporters": ["progress", "html", "json"],
    "concurrency": 2,
    "thresholds": {
      "high": 90,
      "low": 90,
      "break": 90
    }
  }
}
