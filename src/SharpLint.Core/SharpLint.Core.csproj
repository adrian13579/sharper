<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Ship XML docs so DSL-facing types (e.g. NamingConvention) surface descriptions during autocomplete.
         CS1591 is suppressed because only the DSL-facing surface is documented, not every public type. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>SharpLint.Core</PackageId>
    <Version>1.0.0-dev</Version>
    <Authors>SharpLint</Authors>
    <Description>Rule and diagnostic abstractions for the SharpLint analyzer.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

</Project>
