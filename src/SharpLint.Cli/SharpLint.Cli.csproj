<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpLint.Cli</RootNamespace>
    <AssemblyName>sharplint</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sharplint</ToolCommandName>
    <PackageId>sharplint</PackageId>
    <Version>0.2.0-prealpha.1</Version>
    <Title>Sharplint</Title>
    <Authors>adrian13579</Authors>
    <Description>Read-only Roslyn LSP diagnostics for coding agents through MCP and CLI.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/adrian13579/sharplint</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adrian13579/sharplint</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp;roslyn;lsp;mcp;diagnostics;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SharpLint.Analysis/SharpLint.Analysis.csproj" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
